{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", ".firebaserc", "*.md", ".github"],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self' https: data: blob: 'unsafe-eval' 'unsafe-inline'; connect-src 'self' https: wss:;"
          }
        ]
      }
    ]
  }
}
